{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/takan003/campus-toolkit-theme-marketplace/schema/index.schema.json",
  "title": "campus-toolkit Theme Marketplace Index",
  "description": "主題市集入口索引契約（為了相容 campus-toolkit 模組市集解析器，陣列鍵名沿用 modules）。",
  "type": "object",
  "required": ["generatedAt", "marketplaceVersion", "modules"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "索引產出時間（ISO 8601）。"
    },
    "marketplaceVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "市集資料契約版本（semver）。"
    },
    "modules": {
      "type": "array",
      "description": "主題條目清單。第一版沿用 modules 鍵名以相容既有模組市集解析程式。",
      "items": { "$ref": "#/definitions/module" }
    }
  },
  "definitions": {
    "module": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "version",
        "latestVersion",
        "minHostVersion",
        "repoUrl",
        "downloadUrl",
        "checksumSha256",
        "category",
        "tags"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "主題唯一識別（kebab-case），須與 theme.json 的 id 一致。"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "此條目發佈的主題版本。"
        },
        "latestVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "目前最新版本，host app 以此與已安裝版本比對更新。"
        },
        "minHostVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "支援的最小 host app 版本，低於此版本禁止安裝。"
        },
        "repoUrl": { "type": "string", "format": "uri" },
        "previewUrl": {
          "type": "string",
          "format": "uri",
          "description": "主題預覽圖的絕對位址（選填）。host app 管理頁可用於卡片預覽。"
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "description": "主題 zip 下載位址。必須為 HTTPS，且 hostname 須與市集來源一致。"
        },
        "checksumSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "zip 檔案的 SHA-256 雜湊（64 碼小寫 hex），安裝前必須驗證。"
        },
        "category": { "const": "theme" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
